{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/system_bundle.schema.json",
  "title": "System navigator declared bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "members"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Must exactly equal the bundle file's filename stem (bundle files are named <id>.json). A mismatch is loaded as BundleIdMismatchError, not silently accepted -- scope resolution for bundle:<id> is exact only."
    },
    "label": {"type": "string", "minLength": 1},
    "members": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
