{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/diag.schema.json",
  "title": "Diagram frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "illustrates", "diagram_file"],
  "properties": {
    "id": {"type": "string", "pattern": "^DIAG-[A-Z0-9-]+$"},
    "kind": {"const": "diag"},
    "title": {"type": "string", "minLength": 1},
    "focus": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "illustrates": {
      "oneOf": [
        {"type": "string", "pattern": "^(FEAT|ADR)-[A-Z0-9-]+$"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(FEAT|ADR)-[A-Z0-9-]+$"}
        }
      ]
    },
    "diagram_file": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.html$"
    }
  }
}
