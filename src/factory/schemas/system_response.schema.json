{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/system_response.schema.json",
  "title": "System navigator response envelope",
  "description": "Design SS7.1 composed projection shape: the browser assembles this from the separate brief/matrix/timeline/guide calls -- no single CLI invocation emits it. This version defines `scope`, `brief`, `matrix`, `timeline`, and `guide`. A top-level `freshness` field previously appeared here, but no producer (CLI subcommand or browser composition) ever emitted it -- only test fixtures populated it, which the design SS7.1 amendment (commit 2b771a8) calls out as fiction that must be dropped rather than carried. It was removed rather than given an invented producer: computing an aggregate freshness client-side would be browser-side freshness logic, which design section 13 rules out as a non-goal. `story` (increment B) is a separate, optional member: it is `task:`-scoped rather than sharing this envelope's top-level bundle/sr `scope`, produced only by the standalone `factory-system story` CLI call, and no existing envelope composition emits it -- so it is not in the top-level `required` list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "brief", "matrix", "timeline", "guide"],
  "properties": {
    "scope": {"$ref": "#/$defs/topScopeRef"},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "claims"],
      "properties": {
        "scope": {"$ref": "#/$defs/topScopeRef"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "degraded": {"type": "boolean"},
        "degraded_reasons": {"type": "array", "items": {"type": "string"}},
        "member_of": {"type": "array", "items": {"type": "string"}}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "rows"],
      "properties": {
        "scope": {"$ref": "#/$defs/topScopeRef"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/matrixRow"}}
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "events", "degraded", "degraded_reasons"],
      "properties": {
        "scope": {"$ref": "#/$defs/topScopeRef"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/timelineEvent"}},
        "degraded": {"type": "boolean"},
        "degraded_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "guide": {
      "description": "Matches `SystemGuide` (design SS5.3): a scope plus an ordered list of claim sections. Each section is a full claim -- either synthesized prose with verified verbatim spans (when every supporting dependency is fresh) or recorded bullets (design SS4.4's collapse predicate).",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "sections"],
      "properties": {
        "scope": {"$ref": "#/$defs/topScopeRef"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "story": {
      "description": "Matches `factory.system.story.query_story` (increment B, forward half of the V-cycle): one task's implementation story, assembled from recorded evidence manifests and session records.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "task", "runs", "requirements", "degraded", "degraded_reasons", "plan_section"],
      "properties": {
        "scope": {"$ref": "#/$defs/storyScopeRef"},
        "task": {"$ref": "#/$defs/storyTask"},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/storyRun"}},
        "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "degraded": {"type": "boolean"},
        "degraded_reasons": {"type": "array", "items": {"type": "string"}},
        "plan_section": {
          "description": "The source plan's `### Task N:` section for this task, or null when the task declares no source_plan, the plan file is unreadable, or no section matches.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan_path", "heading", "body"],
              "properties": {
                "plan_path": { "type": "string", "minLength": 1 },
                "heading": { "type": "string", "minLength": 1 },
                "body": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "reverse": {
      "description": "Matches `factory.system.reverse.query_reverse` (increment B, reverse half of the V-cycle): walks a `file:` scope back through the evidence manifest(s) that recorded it as a changed file, to the task that produced it, to the requirement(s) it satisfies. A separate, optional member, produced only by the standalone `factory-system reverse` CLI call -- same status as `story` above, not in the top-level `required` list.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "paths", "degraded", "degraded_reasons"],
      "properties": {
        "scope": {"$ref": "#/$defs/reverseScopeRef"},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/reversePath"}},
        "degraded": {"type": "boolean"},
        "degraded_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "topScopeRef": {
      "description": "The top-level scope kinds a briefing/matrix can be requested for (design SS2 item 6, SS5.1) -- a different, wider set than matrixRow.subject below.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["bundle", "sr"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "matrixSubjectRef": {
      "description": "Matches system_matrix_row.schema.json's scopeRef exactly -- kept in sync deliberately, not by cross-file $ref (schema_validator.py loads a single file with no resolver, so inlining is forced; see test_matrix_row_rejected_by_row_schema_is_also_rejected_by_envelope for a drift guard). `kind` is `sr` only: the matrix is a validation matrix (design SS7.3, amended at commit 561c89a) -- task status belongs to the brief, decisions belong to the timeline.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["sr"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "anchor"],
      "properties": {
        "kind": {
          "enum": ["manifest", "task", "requirement", "validation", "review", "decision", "trace", "bundle", "session"]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "anchor": {"type": ["string", "null"]}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citation_index"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "citation_index": {"type": "integer", "minimum": 0}
      }
    },
    "freshnessDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected", "actual"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expected": {"type": ["string", "null"]},
        "actual": {"type": ["string", "null"]}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "dependencies"],
      "properties": {
        "state": {"enum": ["fresh", "stale", "degraded", "n/a"]},
        "reason": {"type": ["string", "null"]},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/freshnessDependency"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "citations", "spans", "freshness"],
      "properties": {
        "kind": {"enum": ["recorded", "derived", "synthesized", "missing"]},
        "text": {"type": "string"},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "freshness": {"$ref": "#/$defs/freshness"},
        "implementation_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runs", "latest_outcome", "changed_file_count", "latest_validation"],
          "properties": {
            "runs": {"type": "integer", "minimum": 0},
            "latest_outcome": {"type": ["string", "null"]},
            "changed_file_count": {"type": ["integer", "null"], "minimum": 0},
            "latest_validation": {"type": ["string", "null"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "missing"}}, "required": ["kind"]},
          "then": {"properties": {"freshness": {"properties": {"state": {"const": "n/a"}}}}}
        },
        {
          "if": {
            "not": {"properties": {"kind": {"const": "missing"}}, "required": ["kind"]}
          },
          "then": {
            "properties": {"freshness": {"properties": {"state": {"not": {"const": "n/a"}}}}}
          }
        },
        {
          "if": {
            "not": {"properties": {"kind": {"const": "synthesized"}}, "required": ["kind"]}
          },
          "then": {"properties": {"spans": {"maxItems": 0}}}
        }
      ]
    },
    "matrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "status", "evidence", "freshness", "summary"],
      "properties": {
        "subject": {"$ref": "#/$defs/matrixSubjectRef"},
        "status": {"enum": ["passed", "failed", "error", "blocked", "never-run", "unknown"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "freshness": {"$ref": "#/$defs/freshness"},
        "summary": {"type": "string"}
      }
    },
    "timelineSubjectRef": {
      "description": "Matches system_timeline_event.schema.json's scopeRef exactly -- kept in sync deliberately, not by cross-file $ref (see matrixSubjectRef's comment above for why; test_timeline_event_rejected_by_event_schema_is_also_rejected_by_envelope is the drift guard for this def). A different, wider `kind` set than matrixSubjectRef -- a timeline event's subject is what the decision was about (a task, sr, run, or manifest), not a validation outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["task", "sr", "run", "manifest"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "timelineEvent": {
      "description": "Matches system_timeline_event.schema.json exactly (design SS7.4) -- same drift-guard rationale as matrixRow/timelineSubjectRef above.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "sequence", "actor", "action", "subject", "citation", "freshness"],
      "properties": {
        "at": {"type": ["string", "null"], "format": "date-time"},
        "sequence": {"type": ["integer", "null"], "minimum": 0},
        "actor": {
          "enum": ["human", "dev", "review", "validation", "orchestrator", "unknown", "not-recorded"]
        },
        "action": {
          "enum": ["approved", "rejected", "validated", "repaired", "published", "stopped", "not-recorded"]
        },
        "subject": {"$ref": "#/$defs/timelineSubjectRef"},
        "citation": {"$ref": "#/$defs/citation"},
        "freshness": {"$ref": "#/$defs/freshness"}
      },
      "anyOf": [
        {"properties": {"at": {"type": "string"}}, "required": ["at"]},
        {"properties": {"sequence": {"type": "integer"}}, "required": ["sequence"]}
      ]
    },
    "storyScopeRef": {
      "description": "`query_story` only ever resolves a `task:` scope -- narrower than `topScopeRef` (bundle|sr) above, which is deliberately why this is its own def rather than a shared one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["task"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "storyTask": {
      "description": "The resolved task record a story is about (design increment B): the ledger's own id/title/status. No separate `ref` -- it would always equal `scope.ref` (both come from the same resolved task id), so it isn't duplicated here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "dod"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]+$"},
        "title": {"type": "string"},
        "status": {"type": "string"},
        "dod": {
          "description": "The task's definition of done, as recorded in its frontmatter and parsed by the ledger.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "storyImplementation": {
      "description": "A claim (kind/text/citations/spans/freshness, same coupling rule as `claim` above) plus `changed_files` -- present (a list, possibly empty) only when recorded by a real evidence manifest; `null` for a session-only run, which never captures changed files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "citations", "spans", "freshness", "changed_files"],
      "properties": {
        "kind": {"enum": ["recorded", "derived", "synthesized", "missing"]},
        "text": {"type": "string"},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "freshness": {"$ref": "#/$defs/freshness"},
        "changed_files": {"type": ["array", "null"], "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "missing"}}, "required": ["kind"]},
          "then": {"properties": {"freshness": {"properties": {"state": {"const": "n/a"}}}}}
        },
        {
          "if": {
            "not": {"properties": {"kind": {"const": "missing"}}, "required": ["kind"]}
          },
          "then": {
            "properties": {"freshness": {"properties": {"state": {"not": {"const": "n/a"}}}}}
          }
        }
      ]
    },
    "storyRun": {
      "description": "One recorded run of a task's story, sourced either from a durable evidence manifest (`source: manifest`, citing `CitationKind.MANIFEST`) or, when no manifest exists for that run, from a session record (`source: session`, citing `CitationKind.SESSION`, `implementation` always missing/n-a). `start_commit`/`result_commit` are `null` for a session-sourced run -- a session record never captures a commit range.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "source", "outcome", "started_at", "ended_at",
        "start_commit", "result_commit", "implementation", "citation"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "source": {"enum": ["manifest", "session"]},
        "outcome": {"type": "string"},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]},
        "start_commit": {"type": ["string", "null"]},
        "result_commit": {"type": ["string", "null"]},
        "implementation": {"$ref": "#/$defs/storyImplementation"},
        "citation": {"$ref": "#/$defs/citation"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "session"}}, "required": ["source"]},
          "then": {
            "properties": {
              "citation": {"properties": {"kind": {"const": "session"}}},
              "start_commit": {"const": null},
              "result_commit": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"source": {"const": "manifest"}}, "required": ["source"]},
          "then": {"properties": {"citation": {"properties": {"kind": {"const": "manifest"}}}}}
        }
      ]
    },
    "reverseScopeRef": {
      "description": "`query_reverse` only ever resolves a `file:` scope -- distinct from `topScopeRef` (bundle|sr) and `storyScopeRef` (task) above.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["file"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "reverseRun": {
      "description": "The evidence manifest run that recorded the walked file in its `implementation.changed_files` (design increment B, reverse half). Always sourced from a durable evidence manifest, citing `CitationKind.MANIFEST` -- session records carry no changed files and cannot participate in a file-anchored walk, so there is no `source`/session variant here (unlike `storyRun`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "outcome", "started_at", "ended_at",
        "start_commit", "result_commit", "implementation", "citation"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "outcome": {"type": "string"},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]},
        "start_commit": {"type": ["string", "null"]},
        "result_commit": {"type": ["string", "null"]},
        "implementation": {"$ref": "#/$defs/storyImplementation"},
        "citation": {"$ref": "#/$defs/citation"}
      }
    },
    "reverseTask": {
      "description": "The resolved task record a path's `task` hop points at, or `null` when the matched run's `task_id` does not resolve in the ledger (`stops_at: \"task\"`).",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]+$"},
        "title": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "reversePath": {
      "description": "One walked path from the file back to a requirement: run -> task -> satisfies. `stops_at` names the first hop that did not resolve (`task` or `satisfies`), or `null` when the chain completes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "run", "task", "requirements", "stops_at"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "run": {"$ref": "#/$defs/reverseRun"},
        "task": {"$ref": "#/$defs/reverseTask"},
        "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "stops_at": {"enum": ["task", "satisfies", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"task": {"type": "null"}}, "required": ["task"]},
          "then": {"properties": {"stops_at": {"const": "task"}}}
        }
      ]
    }
  }
}
