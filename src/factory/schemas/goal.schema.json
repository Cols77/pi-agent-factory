{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/goal.schema.json",
  "title": "Goal frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "feature", "requirements", "metric", "target"],
  "properties": {
    "id": {"type": "string", "pattern": "^GOAL-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "feature": {"type": "string", "pattern": "^FEAT-[A-Z0-9-]+$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SR-[A-Z0-9-]+$"}
    },
    "metric": {"type": "string", "pattern": "^MET-[A-Z0-9-]+$"},
    "target": {"type": "string", "minLength": 1}
  }
}
