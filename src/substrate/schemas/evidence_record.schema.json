{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/evidence_record.schema.json",
  "title": "Factory manual historical evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "task_id",
    "recorded_at",
    "recorded_by",
    "reason",
    "start_commit",
    "result_commit",
    "changed_files",
    "task_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {
      "type": "string",
      "pattern": "^manual-T-[0-9]+-[a-f0-9]{12}$"
    },
    "task_id": {"type": "string", "pattern": "^T-[0-9]+$"},
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "recorded_by": {"type": "string", "pattern": "\\S"},
    "reason": {"type": "string", "pattern": "\\S"},
    "start_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "result_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[^\\u0000/]+(?:/[^\\u0000/]+)*$"
      }
    },
    "task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
