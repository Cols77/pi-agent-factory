__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Windows reserved device name that git readdir can pick up; breaks `git add -A`
nul

# Redirected test output. Three of these were committed by accident, one named
# with a literal `%TEMP%` -- a Windows variable that bash does not expand, so the
# redirect created a file in the repo root instead of the temp directory.
test_output.txt
*pytest_out.txt
*pytest_err.txt

# Factory run-time artifacts. The whole of sessions/ is local-only: transcript
# logs, live status/lock, regenerated summaries, the per-run *.session.json
# records and the session-report retrospectives. The orchestrator writes these
# via `git add -A` during commit_all and they bloat history badly -- these
# records are machine transcripts of whole runs, and four of them alone reached
# ~300MB against ~1KB for the early ones. Nothing reads them through git:
# load_session_runs globs the directory from disk and returns [] when it is
# absent, and write_session mkdirs it. .gitkeep stays tracked so a fresh clone
# still has the directory.
#
# git_ops.py excludes sessions/.factory-runs/ and sessions/.factory-transcripts/
# by path as well, because that fix must hold in a target repo that never
# inherits this file.
sessions/*
!sessions/.gitkeep

# Content-addressed evidence blobs; compact evidence/runs manifests stay tracked.
.factory/artifacts/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Per-plan working state; the git history is the durable record.
.superpowers/

# Obsidian per-window UI state (churns constantly; not project config)
.obsidian/workspace.json

# Durable code-context bundle (item 2) - recomputed on change at session open
.factory/code-index/
