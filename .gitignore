__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Windows reserved device name that git readdir can pick up; breaks `git add -A`
nul

# Factory run-time artifacts: transcript logs, live status/lock, regenerated
# summaries. These are per-run scratch the orchestrator writes via `git add -A`
# during commit_all; they bloat history and never belong in the repo. The
# durable per-run records (sessions/*.session.json) stay tracked.
sessions/.factory-transcripts/
sessions/.factory-status.json
sessions/.factory-run.log
sessions/.factory-run.lock
sessions/latest.md
