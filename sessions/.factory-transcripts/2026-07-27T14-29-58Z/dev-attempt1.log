lete_after_all_waypoints(self):\n        fc = FakeFlightController()\n        seq = WaypointSequencer(fc)\n        plan = NavPlan(\n            waypoints=[Pose(0, 0, 5, 0)], algorithm_name=\"test\", created_at=0\n        )\n        seq.set_plan(plan)\n        fc.arm()\n        fc.takeoff(5.0)\n        for _ in range(200):\n            fc.step(0.05)\n        # Reach the waypoint\n        for _ in range(200):\n            seq.step(0.05)\n        assert seq.is_complete() is True\n\n\nclass TestWaypointSequencerStatus:\n    def test_status_format(self):\n        fc = FakeFlightController()\n        seq = WaypointSequencer(fc)\n        plan = NavPlan(\n            waypoints=[Pose(1, 0, 5, 0), Pose(2, 0, 5, 0), Pose(3, 0, 5, 0)],\n            algorithm_name=\"sweep\",\n            created_at=0,\n        )\n        seq.set_plan(plan)\n        s = seq.status()\n        assert s == {\n            \"current_idx\": 0,\n            \"total\": 3,\n            \"completed\": 0,\n            \"plan_name\": \"sweep\",\n        }"}],"isError":false,"timestamp":1785165290730}}
